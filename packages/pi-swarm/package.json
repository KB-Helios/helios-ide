{
	"name": "pi-swarm",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./index.ts",
		"./index.ts": "./index.ts",
		"./package.json": "./package.json"
	},
	"description": "A /swarm for pi: a coordinator splits a task across named workers that coordinate on one shared @mention board, each in its own git worktree, with quality gates, a read-only reviewer and a verifier before work is handed back. Remote A2A agents can join as members.",
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"extension",
		"swarm",
		"multi-agent"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@thinkrail/pi-a2a": "workspace:*",
		"pi-delegation": "workspace:*",
		"pi-subagents": "workspace:*"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "catalog:",
		"@earendil-works/pi-ai": "catalog:",
		"@earendil-works/pi-coding-agent": "catalog:",
		"@types/bun": "catalog:",
		"typebox": "catalog:",
		"typescript": "catalog:"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	}
}
